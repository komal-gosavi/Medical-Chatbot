## Environment Variables for Medical Chatbot

# Pinecone Vector Database
# Get your API key from: https://console.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here

# Groq LLM (Free)
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Configuration (Optional - defaults provided)
# PINECONE_INDEX=medical-chatbot
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Embedding Model (Optional - using free HuggingFace model)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq Model (Optional)
# GROQ_MODEL=llama-3.1-8b-instant

# Server Configuration
# HOST=0.0.0.0
# PORT=8000
# DEBUG=False
